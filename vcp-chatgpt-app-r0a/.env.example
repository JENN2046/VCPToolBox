# ===== R0-A MCP server =====
HOST=127.0.0.1
PORT=3010

# ===== VCPToolBox main server =====
# Direct connection: MCP App -> VCPToolBox :6005
VCP_BASE_URL=http://127.0.0.1:6005

# config.env 的 Key=，不是上游模型 API_Key。
VCP_API_KEY=replace-with-vcp-Key

# VCP request timeout in milliseconds.
VCP_TIMEOUT_MS=120000

# ===== Full VCP chat pipeline =====
# vcp_chat 默认调用 VCP 主链 /v1/chat/completions。
# 调试时如要强制显示 VCP tool 信息，可改为 /v1/chatvcp/completions。
VCP_CHAT_PATH=/v1/chat/completions

# 可选默认模型。留空时 vcp_chat 每次必须传 model。
VCP_DEFAULT_MODEL=

# 可选：为完整 VCP cognition/memory pipeline 注入固定 system prompt。
# 推荐用文件，路径相对于本项目工作目录。
VCP_SYSTEM_PROMPT_FILE=
VCP_SYSTEM_PROMPT=

# ===== Persistent-memory authority plane =====
# Independent from VCP_SYSTEM_PROMPT_FILE and its chat/cognition persona.
# VCP_MEMORY_MAID is authoritative. Caller maid, when supplied, is only a compatibility assertion and cannot switch owner.
# Folder selection remains bounded by VCP_MEMORY_OWNED_FOLDERS.
VCP_MEMORY_MAID=NuobaoChatGPT
VCP_MEMORY_OWNED_FOLDERS=NuobaoChatGPT,NuobaoChatGPT的知识,Nobao-Episodes,Nobao-Projects,Nobao-Profile,Nobao-Lessons,Nobao-Archive

# Absolute VCPToolBox DailyNote root used only for read-only uniqueness preflight.
# Never expose this value as an MCP tool parameter.
VCP_DAILYNOTE_ROOT=/path/to/VCPToolBox/dailynote

# ===== Real smoke toggles =====
# 先保持 false，只测连接；确认后再开启读记忆与 chat。
VCP_SMOKE_MEMORY=false
VCP_SMOKE_CHAT=false
VCP_SMOKE_QUERY=VCP memory smoke test
VCP_SMOKE_FOLDER=
VCP_SMOKE_MAID=
VCP_SMOKE_K=3
